# WorkBuddy agent 内部数据（非项目源码，不入库）
.workbuddy/

# OS / 编辑器垃圾
.DS_Store
Thumbs.db
*.tmp
*.swp

# Godot 4.x 编辑器/导入生成物。
# global_script_class_cache.cfg 由 CI（tools/gen_global_class_cache.gd）幂等重建，
# 无需入库；headless -s 模式依赖它注册 class_name 全局类。
.godot/
# asset_manifest.csv 由 palette_validator.gd 用 FileAccess 直接读纯文本；
# Godot 会误把它当翻译表导入并生成 .csv.import / *.translation 副产物，均为噪音。
src/core/asset_pipeline/*.translation
src/core/asset_pipeline/*.csv.import

# GUT 9.3.0 由 CI 安装到 addons/gut/（本地 headless 实跑副本同样不入库）。
# 只忽略该子目录而非整个 addons/，以便未来其他正式插件仍可入库。
addons/gut/

# Windows Desktop 导出产物（Wave 2b / ADR-6）：exe、pck 与 console wrapper 不入库。
/build/

# Python 工具脚本（tools/qa/verify_probe_evidence.py 等）的运行缓存不入库。
__pycache__/
*.pyc
